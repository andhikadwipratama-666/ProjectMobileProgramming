<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <!-- Judul Form -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Form Top-Up E-Wallet"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Kotak Input Nomor HP -->
    <EditText
        android:id="@+id/etNomorHp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan Nomor HP Tujuan"
        android:inputType="phone"
        android:layout_marginBottom="16dp" />

    <!-- Kotak Input Nominal Uang -->
    <EditText
        android:id="@+id/etNominal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan Nominal (Contoh: 50000)"
        android:inputType="number"
        android:layout_marginBottom="24dp" />

    <!-- Tombol Proses -->
    <Button
        android:id="@+id/btnProses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proses Top-Up" />

</LinearLayout>